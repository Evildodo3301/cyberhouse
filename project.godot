; Engine configuration file.
; You normally edit this through Project > Project Settings in the Godot editor,
; not by hand.

config_version=5

[application]

config/name="Cyberhouse"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input]

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
aim_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194319)]
}
aim_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194321)]
}
aim_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194320)]
}
aim_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194322)]
}
attack={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
throw_bomb={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="unused"
2d_physics/layer_4="enemy_body"
2d_physics/layer_5="doors"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.03, 0.02, 0.06, 1)

[autoload]

Game="*res://scripts/core/game.gd"
TacticTracker="*res://scripts/core/tactic_tracker.gd"
